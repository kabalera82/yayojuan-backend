root = true

[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.{js,jsx,ts,tsx}]
indent_size = 2
quote_type = double
max_line_length = 100

[*.json]
indent_size = 2

[*.php]
indent_size = 4

[*.{yaml,yml}]
indent_size = 4

[*.{html,twig,html.twig}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
