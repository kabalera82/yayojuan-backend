# Puerto en el que arranca el servidor Express
PORT=3000

# Cadena de conexión de MongoDB (mongoose)
MONGODB_URI=<mongodb-uri>

# Secreto para firmar/verificar JWT (jsonwebtoken)
JWT_SECRET=<jwt-secret>

# Credenciales de Cloudinary (cloudinary)
CLOUDINARY_CLOUD_NAME=<cloudinary-cloud-name>
CLOUDINARY_API_KEY=<cloudinary-api-key>
CLOUDINARY_API_SECRET=<cloudinary-api-secret>

# Origen permitido para CORS (URL del frontend desplegado)
FRONTEND_URL=<frontend-url>
